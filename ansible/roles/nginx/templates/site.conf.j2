server {
    listen 80;
    listen [::]:80;

    server_name {{ item.domain }}{% for alias in item.aliases | default([]) %} {{ alias }}{% endfor %};

    root {{ item.webroot }};

    location ^~ /.well-known/acme-challenge/ {
        root {{ item.webroot }};
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

{% if item.name == "atticladderph" %}
server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name {{ item.domain }}{% for alias in item.aliases | default([]) %} {{ alias }}{% endfor %};

    client_max_body_size 10m;

    ssl_certificate /etc/letsencrypt/live/atticladderph.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/atticladderph.com/privkey.pem;

    root {{ item.webroot }};
    index index.cfm index.html index.htm;

    location / {
        proxy_pass http://127.0.0.1:{{ item.lucee.port }};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
{% endif %}